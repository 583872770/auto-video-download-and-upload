# 唯一环境模板：复制为 .env，已有配置请直接编辑，不要覆盖。
# 推荐启动后访问 /setup，在页面选择角色、配置 MySQL 和实例地址。
# 下面只需设置 Docker 宿主机端口、目录；数据库参数可留空。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=video_downloads
MYSQL_USER=video
# 可选：直接填原始密码，单引号保留 $ 和 #。页面保存后优先用页面配置。
MYSQL_PASSWORD=''

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
# HTTPS 反向代理部署时设为 1，HTTP 本地访问保持 0。
VIDEO_WEB_HTTPS=0
TZ=Asia/Shanghai
# Docker 引擎所在机器的视频目录；SSH 连接 Linux 时必须填写服务器绝对路径。
# 本机 Windows Docker Desktop 可改为 D:/youtube-videos。
VIDEO_DOWNLOAD_DIR=/srv/youtube-videos

YT5S_DESKTOP_PORT=16080

# 可选，推荐在页面选择：hybrid 管理与下载一体、manager 纯管理端、worker 纯下载实例、all 单机模式。
VIDEO_SERVICE_ROLE=
# ID 留空自动生成。不同实例使用独立状态卷。
VIDEO_INSTANCE_ID=
VIDEO_INSTANCE_NAME=
VIDEO_INSTANCE_URL=
