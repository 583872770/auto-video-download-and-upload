# Copy to .env for compose.remote-mysql.yaml. Edit an existing .env instead
# of overwriting it if this deployment already has configuration.
MYSQL_HOST=mysql.example.com
MYSQL_PORT=3306
MYSQL_DATABASE=video_downloads
MYSQL_USER=video
# Raw password; single quotes keep $ and # literal. No URL encoding needed.
MYSQL_PASSWORD=''

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
TZ=Asia/Shanghai
VIDEO_DOWNLOAD_DIR=./docker-data/videos
