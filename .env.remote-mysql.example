# 远程 MySQL 环境模板：复制为 .env，已有配置请直接编辑，不要覆盖。
# 启动前在此配置 MySQL；/setup 页面只配置实例并测试连接。
# 请填写数据库连接参数，以及 Docker 宿主机端口和目录。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=video_downloads
MYSQL_USER=video
# 填写原始密码，单引号保留 $ 和 #；数据库连接只读取启动配置。
MYSQL_PASSWORD=''

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
# HTTPS 反向代理部署时设为 1，HTTP 本地访问保持 0。
VIDEO_WEB_HTTPS=0
TZ=Asia/Shanghai
# Docker 引擎所在机器的视频目录；SSH 连接 Linux 时必须填写服务器绝对路径。
# 本机 Windows Docker Desktop 可改为 D:/youtube-videos。
VIDEO_DOWNLOAD_DIR=/srv/youtube-videos

YT5S_DESKTOP_PORT=16080

# 服务固定为管理与下载一体，无需设置角色。旧 VIDEO_SERVICE_ROLE 值仍可读取。
# ID 留空自动生成。不同实例使用独立状态卷；更新原实例时保留原 ID。
# 实例设置保存后优先使用已保存值（数据库除外）；新增实例不要复制旧状态卷。
VIDEO_INSTANCE_ID=
VIDEO_INSTANCE_NAME=
VIDEO_INSTANCE_URL=
# 国内服务器构建镜像（可按服务器网络改为 mirrors.cloud.tencent.com 或 mirrors.aliyun.com）
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# MySQL 主服务连接池：默认 5 个常驻连接、最多额外 2 个；
# 服务器连接数较小可下调，连接数充足时可适当上调。
VIDEO_DB_POOL_SIZE=5
VIDEO_DB_MAX_OVERFLOW=2
# 每个下载子进程独立建池，同时为业务写入和租约心跳留出容量。
VIDEO_WORKER_DB_POOL_SIZE=2
VIDEO_WORKER_DB_MAX_OVERFLOW=0
# 自动模式的下载工作进程总连接预算（不含主服务、维护进程）。
VIDEO_WORKER_DB_CONNECTION_BUDGET=48

# Docker 部署安全：设为 true 允许 Docker 内部首次配置访问。
# 如果通过反向代理部署，必须设为 true 才能访问 /setup 页面。
# 单机直连部署无需设置（默认检测 127.0.0.1）。
VIDEO_ALLOW_LOCAL_SETUP=true

# 反向代理配置：设为 true 信任 X-Forwarded-For 头部（需反向代理正确配置）。
# 仅在 nginx/Caddy 等反向代理环境中启用，直连部署保持注释。
# VIDEO_TRUSTED_PROXY=true
