# 本地 MySQL 容器方案：复制为 .env.local-mysql，再替换 MYSQL_PASSWORD。
# 应用账号和 root 账号在首次初始化时统一使用 MYSQL_PASSWORD。
# 单引号可保留密码中的 $、# 等字符；应用账号不要使用 root。
MYSQL_DATABASE=video_downloads
MYSQL_USER=video
MYSQL_PASSWORD='replace-with-your-app-password'

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
VIDEO_WEB_HTTPS=0
TZ=Asia/Shanghai
# Docker 引擎所在机器的视频目录；Windows Docker Desktop 可改为 D:/youtube-videos。
VIDEO_DOWNLOAD_DIR=/srv/youtube-videos
YT5S_DESKTOP_PORT=16080

DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
