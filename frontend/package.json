{
  "name": "frameflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "format": "prettier --write src vite.config.ts tsconfig.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json"
  },
  "dependencies": {
    "element-plus": "^2.11.8",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.2",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.1.12",
    "vue-tsc": "^3.1.4"
  }
}
