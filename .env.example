# Copy to .env and set a unique database password before starting.
# Single quotes keep $ and # literal in Docker Compose .env values.
MYSQL_PASSWORD=''
MYSQL_ROOT_PASSWORD=''
MYSQL_USER=video
MYSQL_DATABASE=video_downloads

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
TZ=Asia/Shanghai

# Windows example: D:/youtube-videos
# Linux example: /srv/youtube-videos
VIDEO_DOWNLOAD_DIR=./docker-data/videos
