# 场景二：只部署应用，连接远程 MySQL 和 Redis。
# 新部署复制为 .env，已有 .env 请直接编辑。/setup 不负责修改数据库连接。
# 必填：MYSQL_HOST、MYSQL_PASSWORD、REDIS_URL；远程库和专用账号需提前创建。
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=video_downloads
MYSQL_USER=video
# 原始密码，无需 URL 编码；单引号保留 $、# 等字符。应用账号不要使用 root。
MYSQL_PASSWORD=''
# 例如 redis://:经过URL编码的密码@redis.example.com:6379/0；TLS 使用 rediss://。
# 无密码时使用 redis://redis.example.com:6379/0；多实例使用同一 Redis 库。
REDIS_URL=''

WEB_BIND_IP=127.0.0.1
WEB_PORT=5000
VIDEO_WEB_HOSTS=localhost,127.0.0.1,[::1]
VIDEO_WEB_HTTPS=0
TZ=Asia/Shanghai
# Docker 引擎所在机器的绝对路径；Windows Docker Desktop 可改为 D:/youtube-videos。
VIDEO_DOWNLOAD_DIR=/srv/youtube-videos
# 仅监听宿主机回环地址；通过 SSH 隧道访问浏览器桌面。
YT5S_DESKTOP_PORT=6080

# 留空自动生成实例 ID；升级保留状态卷，新实例不要复制旧状态卷。
VIDEO_INSTANCE_ID=
VIDEO_INSTANCE_NAME=
VIDEO_INSTANCE_URL=
# 使用账号管理时必填：openssl rand -base64 32 生成；所有共享数据库实例使用同一密钥。
# 已有实例保留原密钥，丢失或更换将无法解密已有账号资料。
VIDEO_ACCOUNT_ENCRYPTION_KEY=

VIDEO_DB_POOL_SIZE=5
VIDEO_DB_MAX_OVERFLOW=2
VIDEO_WORKER_DB_POOL_SIZE=2
VIDEO_WORKER_DB_MAX_OVERFLOW=0

# 按服务器网络调整构建源；洛杉矶服务器可用 deb.debian.org 和 pypi.org/simple。
DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# MIHOMO_DOWNLOAD_BASE_URL=
